# Generated by Cargo
# will ignore target/ directory, Cargo.lock, etc.
target/
**/*.rs.bk
**/*.swp
Cargo.lock

# By default, Cargo will ignore build artifacts and lock files.
# If you use custom build scripts, ignore their output too:
build/

# If you use rustfmt or clippy, ignore their backup files:
**/*.rs.bk

# IDE/editor files
.idea/
.vscode/
*.iml

# OS generated files
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
*.bak

# Coverage
coverage/
*.profraw

# Node/npm (if using frontend)
node_modules/
npm-debug.log*

# Other
.env
*.secret

*.sym
